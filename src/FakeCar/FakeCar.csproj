<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FakeCar</AssemblyName>
    <RootNamespace>FakeCar</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.6.6</Version>
    <ApplicationIcon>fakecar.ico</ApplicationIcon>
    <Product>Fake Car</Product>
    <AssemblyTitle>Fake Car by esysmax</AssemblyTitle>
    <Company>esysmax</Company>
    <Authors>esysmax</Authors>
    <Description>Fake Car by esysmax (esysmax.com): a pretend BMW for E-Sys</Description>
    <Copyright>Copyright (c) 2026 esysmax</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FakeCar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="fakecar.ico" LogicalName="FakeCar.fakecar.ico" />
  </ItemGroup>

</Project>
